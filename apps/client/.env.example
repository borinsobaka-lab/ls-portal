# Клиентское приложение. Все переменные — публичные, вшиваются в бандл при
# сборке: в Coolify — "Build Variable". Секретов здесь нет и быть не должно.

# Supabase self-hosted: адрес API и ключ anon (JWT eyJ...; имя переменной
# прежнее, supabase-js принимает оба формата).
VITE_SUPABASE_URL=https://api.example.ru
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Формат сборки: packages — приложение пакетных клубов; пусто — подписочное.
# VITE_APP_FORMAT=packages

# Адреса приложений форматов (как у портала).
# VITE_SUBSCRIPTION_APP_URL=
# VITE_PACKAGES_APP_URL=https://app.example.ru

# Политика конфиденциальности (пакетное): операторы — JSON-массив
# [{"name":"…","idCode":"…","studio":"…","address":"…","phone":"…"}],
# почта и дата редакции.
# VITE_PRIVACY_OPERATORS=[]
# VITE_PRIVACY_EMAIL=privacy@example.ru
# VITE_PRIVACY_EFFECTIVE_DATE=2026-10-26

# Связь со студией (экран входа, «Поддержка»), приглашение подруги, запись
# на массаж. Пусто — кнопки или ссылки нет.
# VITE_STUDIO_WHATSAPP_URL=
# VITE_STUDIO_INSTAGRAM_URL=
# VITE_STUDIO_MESSENGER_URL=
# VITE_INVITE_URL=
# VITE_MASSAGE_BOOKING_URL=
