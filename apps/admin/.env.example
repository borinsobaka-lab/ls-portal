# Портал Lady Stretch (apps/admin). Значения — только в Coolify, в
# репозиторий не кладутся. Подробно — DEPLOY.md в корне репозитория.

# --- Supabase (build: вшиваются в бандл, в Coolify — "Build Variable") ---
# Адрес API self-hosted Supabase и ключ anon (JWT eyJ...; имя переменной
# прежнее, supabase-js принимает оба формата).
VITE_SUPABASE_URL=https://api.example.ru
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
# Адреса клиентских приложений форматов (пусто — приложение не развёрнуто).
# VITE_SUBSCRIPTION_APP_URL=
# VITE_PACKAGES_APP_URL=

# --- Сервер (runtime-секреты, в бандл не попадают) ---
# service_role JWT этого же Supabase: пользователи портала, файлы, рассылки.
APP_SUPABASE_SERVICE_KEY=
# Прямое подключение к Postgres для мигратора (пользователь postgres). На
# пустой базе первый старт сам собирает схему (db/bootstrap.ts).
DATABASE_URL=postgres://postgres:...@supabase-db:5432/postgres
# Адрес портала: по нему хук писем отличает вход в портал от входа в
# клиентское приложение; с него же грузится логотип в письме. Обязателен.
ADMIN_APP_URL=https://portal.example.ru

# --- Auth-письма (Send Email Hook, /api/auth-email) ---
# Пока не заданы секрет, почта и ADMIN_APP_URL, роут отвечает 500 — хук в
# Supabase включать только после них. Тот же секрет, что в
# GOTRUE_HOOK_SEND_EMAIL_SECRETS сервиса auth (v1,whsec_...).
SEND_EMAIL_HOOK_SECRET=
# SMTP почтового хостинга (reg.ru): 465 — SSL, 587 — STARTTLS. Логин и
# пароль — ящика отправителя.
SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=465
SMTP_USER=noreply@example.ru
SMTP_PASS=
# Отправитель (по умолчанию — SMTP_USER) и название в письме.
MAIL_FROM=noreply@example.ru
MAIL_FROM_NAME=Lady Stretch
# Необязательно: бренд писем портала (ladyStretch по умолчанию, base40),
# свой адрес логотипа письма, адреса пакетного приложения через запятую.
# EMAIL_BRAND=ladyStretch
# EMAIL_LOGO_URL=
# PACKAGES_APP_URLS=
# Запасной путь, если SMTP не задан: Resend.
# RESEND_API_KEY=

# --- Пуши (необязательно) ---
# Контакт отправителя для служб доставки (по умолчанию — mailto:MAIL_FROM);
# PUSH_WORKER=off — не рассылать с этого сервера.
# VAPID_SUBJECT=mailto:noreply@example.ru
# PUSH_WORKER=off

# --- «Аналитика» (ANALYTICS.md, DEPLOY.md шаг 15) ---
# Ключ шифрования ключей подключений (VK Ads, amoCRM, Авито, FitBase,
# Telegram): 32 байта base64; не менять — иначе сохранённые ключи не
# расшифровать.
# ANALYTICS_SECRETS_KEY=
# ANALYTICS_JOBS=off — не выполнять фоновые задачи «Аналитики» на этом сервере.
# ANALYTICS_JOBS=off
# Квиз-лендинг на отдельном домене (не /quiz портала): его адреса через
# запятую — приём заявок примет их Origin.
# ANALYTICS_QUIZ_ORIGINS=https://quiz.example.ru

# --- ИИ (Kate, диктовка) — в этой копии выключен: AI_* не задавать ---
