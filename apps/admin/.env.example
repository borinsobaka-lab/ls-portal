# --- Supabase (обязательно) ---
# Публичные значения, вшиваются в клиентский бандл при сборке.
# В Coolify обе переменные должны быть отмечены как "Build Variable".
# Supabase self-hosted (Coolify), API — https://api.base40.fit. Ключ — anon в
# JWT-формате (eyJ...): sb_publishable_ у self-hosted нет, имя переменной
# оставлено прежним, supabase-js принимает оба формата.
VITE_SUPABASE_URL=https://api.base40.fit
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Секрет, только для сервера (раздел «Сотрудники»). Не попадает в бандл.
# service_role JWT self-hosted Supabase (Coolify -> ресурс Supabase ->
# SERVICE_SUPABASESERVICE_KEY). Ключ облачного проекта здесь не работает.
APP_SUPABASE_SERVICE_KEY=

# --- Auth-письма (Send Email Hook, /api/auth-email) ---
# Runtime-секреты, только для сервера. Пока не заданы, роут отвечает 500 —
# хук в Supabase включать ТОЛЬКО после задания секрета и ключа почты и рестарта.
# Тот же секрет, что в GOTRUE_HOOK_SEND_EMAIL_SECRETS сервиса auth в Coolify
# (v1,whsec_...), см. AUTH_SETUP.md в корне репозитория.
SEND_EMAIL_HOOK_SECRET=
# Почта (src/lib/mail.ts): если задан UNISENDER_GO_API_KEY — письма идут через
# Unisender Go (домен base40.fit там подтверждён), иначе — через Resend.
UNISENDER_GO_API_KEY=
# Запасной путь до удаления Resend (домен base40.fit верифицирован в Resend).
RESEND_API_KEY=
# Адрес админки: по хосту в redirect_to обработчик отличает вход в админку
# (письмо со ссылкой) от входа в клиентское приложение (письмо с кодом).
# Значение по умолчанию — https://admin.base40.fit, менять нужно только при
# смене домена.
# ADMIN_APP_URL=https://admin.base40.fit

# --- AI-ассистент и диктовка (пока отключены — провайдер не выбран) ---
# Любой OpenAI-совместимый API. Пока не заданы, /api/chat и /api/transcribe
# отвечают «временно недоступно».
# AI_GATEWAY_BASE_URL=https://api.openai.com/v1
# AI_GATEWAY_API_KEY=
# AI_CHAT_MODEL=gpt-4.1-mini
# AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
